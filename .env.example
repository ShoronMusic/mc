# 洋楽AIチャット - 環境変数例（.env.local にコピーして値を設定）
#
# 分離しないアーティスト名・Music8 検索の別名は環境変数ではなく JSON で編集する:
#   src/config/artist-compound-extra.json
#   src/config/music8-main-artist-aliases.json
# 手順は src/config/README.md を参照（編集後は再ビルド／再デプロイ）。

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 二ブランド（docs/00-music-chat-product-plan.md）— 未設定＝ma（musicaichat / musicai.jp）
# musicaichat … npm run dev（:3002）· Vercel ma プロジェクト
# musicchat … npm run dev:chat（:3003）· Vercel mc プロジェクト
# NEXT_PUBLIC_PRODUCT=musicchat
# 姉妹サイトへの公開 URL（案内リンク用。未設定時は本番デフォルト）
# NEXT_PUBLIC_MA_PUBLIC_URL=https://www.musicai.jp
# NEXT_PUBLIC_MC_PUBLIC_URL=https://www.musicchat.jp
# ローカルで Google 認証したのに本番 (Site URL) に ?code= で飛ぶとき:
# 1) Supabase Redirect URLs に http://localhost:3002/auth/callback を入れる（127.0.0.1 で開いているなら http://127.0.0.1:3002/auth/callback も別途追加）
# OAuth の redirectTo は常に「いま開いているページのオリジン」を使う（NEXT_PUBLIC_APP_ORIGIN は参照しない）
# Google 認証: Dashboard → Authentication → URL Configuration
# Redirect URLs に次を両方入れること:
#   http://localhost:3002/auth/callback   （ma · npm run dev）
#   http://localhost:3003/auth/callback   （mc · npm run dev:chat）
#   https://<本番ドメイン>/auth/callback
# 未登録だと ?code= がトップに付いたままログインできない（アプリ側ミドルウェア・インライン script で救済も可能）。
# マイページの「アカウントを削除」でDBから完全削除する場合に必要（サーバー専用・公開しないこと）
# SUPABASE_SERVICE_ROLE_KEY=
# 管理画面 /admin と /api/admin/* の利用者（Supabase Auth のユーザー UUID をカンマ区切り）。未設定なら /admin は誰も開けない
# 視聴履歴スタイル変更の「管理者のみ」制限にも同じリストを使用（未設定ならスタイルは誰でも変更可）
# STYLE_ADMIN_USER_IDS=
# comment-pack 行を「NG（DBから外す）」できる最高管理者（Supabase Auth のユーザー UUID をカンマ区切り）。未設定なら誰にも NG ボタンは出ない
# AI_TIDBIT_MODERATOR_USER_IDS=
# 上記に加え、ログイン email でも許可（小文字比較・カンマ区切り）。Route Handler では getSession が空になりがちなため getUser を使うが、UUID の設定も推奨
# AI_TIDBIT_MODERATOR_EMAILS=
# 上記はチャットの「DBに報告（チューニング）」ボタンでも同じ（会話スナップショットを ai_chat_conversation_tuning_reports に保存）
# 1 のとき「@」質問の音楽関連チェック・警告・イエローカード・退場を行わない（チューニング期間用。ビルド時にクライアントへ埋め込まれる）
# NEXT_PUBLIC_AI_QUESTION_GUARD_DISABLED=1
# 上記 NG で song_tidbits を更新するとき、RLS を避けるには SERVICE_ROLE 推奨（未設定時はセッション用クライアントのみ）

# エージェントAI（character_chat）の Irodori-TTS 読み上げ（試験）。要 Irodori-TTS-Server（別プロセス・GPU 推奨）
# エージェントAI 音声読み上げ（Irodori-TTS 試験）。既定オフ。ローカル試験時のみ 1
# NEXT_PUBLIC_AI_CHARACTER_TTS_ENABLED=1
# 同期部屋で Ably 経由の他参加者のエージェント発話も各端末で読み上げ（未設定は API を呼んだ端末のみ）
# NEXT_PUBLIC_AI_CHARACTER_TTS_PLAY_INCOMING=1
# 読み上げ音量 0〜1（未設定 0.85）
# NEXT_PUBLIC_AI_CHARACTER_TTS_VOLUME=0.85
# サーバー専用: Irodori-TTS-Server のベース URL（末尾スラッシュなし）。例 http://127.0.0.1:8088
# IRODORI_TTS_SERVER_URL=
# 声質: none＝参照音声なし（sample.wav 不要・試験向け）。WAV を置いたら stem 名（例 sample）
# IRODORI_TTS_VOICE=none
# 初回セットアップ: scripts/setup-irodori-tts-server.ps1 → 別ターミナルで TTS サーバー起動
# 任意: Irodori-TTS-Server の IRODORI_API_KEY と同じ Bearer
# IRODORI_TTS_API_KEY=
# 任意: wav / mp3（既定 wav。mp3 はサーバー側 FFmpeg が必要）
# IRODORI_TTS_RESPONSE_FORMAT=wav
# 速度優先: 拡散ステップ（8〜64、試験は 24〜28）。未設定はサーバー既定 ~40
# IRODORI_TTS_NUM_STEPS=24
# Next.js → Irodori の待ち時間 ms（既定 360000=6分。CPU では短縮ステップと併用推奨）
# AI_CHARACTER_TTS_UPSTREAM_TIMEOUT_MS=360000
# voice=none 時のブレ軽減（声質固定は voices\*.wav + IRODORI_TTS_VOICE=stem を推奨）
# IRODORI_TTS_SEED=42
# TTS サーバー側 E:\Irodori-TTS-Server\.env に GPU 推奨:
#   IRODORI_MODEL_DEVICE=cuda
#   IRODORI_CODEC_DEVICE=cuda
#   IRODORI_PRELOAD=true

# Google Gemini API
GEMINI_API_KEY=
# 「次に聴くなら」試験（曲解説のあと AI が関連曲を 1〜3 本提案）。1 で ON。未設定は OFF
# NEXT_SONG_RECOMMEND_ENABLED=1
# 試験中だけ特定ユーザーに限定するとき（Supabase Auth の UUID をカンマ区切り）。空なら ON 時は全ログインユーザー
# NEXT_SONG_RECOMMEND_BETA_USER_IDS=
# 上記 API のユーザー単位レート（60 秒窓、1〜60、未設定時 8）
# NEXT_SONG_RECOMMEND_RATE_PER_MINUTE=8
# 1 / true で、next-song-recommend の根拠デバッグをサーバーログへ JSON 1行出力
# NEXT_SONG_RECOMMEND_DEBUG_LOG=1
# 1 にすると各 Gemini 呼び出しのトークン数をサーバーログに JSON 1行で出力（料金試算・集計用）
# GEMINI_LOG_USAGE=1
# SUPABASE_SERVICE_ROLE_KEY + gemini_usage_logs テーブルで DB に保存（/admin/gemini-usage）。0 で保存停止
# GEMINI_USAGE_PERSIST=
# 1 にすると同じ動画でも常に comment-pack を AI 新規生成（DB 再利用をオフ）
# COMMENT_PACK_SKIP_CACHE=
# 邦楽っぽいメタデータ（日本語文字・音声言語 ja）のときは基本コメント1本のみ（自由3本を生成せず料金削減）。0 で常に基本＋自由3本
# COMMENT_PACK_JP_ECONOMY=1
# 1 にすると「アーティストがメタで信頼できない」判定をオフにし、従来どおり曲解説・comment-pack を生成する
# AI_COMMENTARY_ALLOW_UNCERTAIN_ARTIST=
# MusicBrainz API（非商用無料）でアーティストの出身/活動地域が日本なら邦楽節約に含める。未設定なら呼び出ししない（User-Agent 必須・公式要件）
# https://musicbrainz.org/doc/MusicBrainz_API
# MUSICBRAINZ_USER_AGENT=musicaichat/0.1.0 ( https://あなたのサイトURL )
# 1 にすると MusicBrainz を使わない（日本語メタ判定のみ）
# MUSICBRAINZ_LOOKUP=0
# 1 にすると「チャンネルと一致しない A - B」向けの録音検索（順序補正）だけオフ。未設定なら USER_AGENT があるときだけ曖昧時に実行
# MUSICBRAINZ_TITLE_ORDER=0
# 邦楽でも、ONE OK ROCK / XG / Ado / ATARASHII GAKKO!（＋88rising）/ YOASOBI の公式 YouTube チャンネル（コード内の UC 固定）上の動画は AI を許可。それ以外の公式チャンネルを足すときは UC… をカンマ区切り
# JP_DOMESTIC_OFFICIAL_CHANNEL_EXCEPTION_IDS=

# YouTube Data API v3（「この曲を貼って」でAIが曲を検索して貼る機能用。未設定ならその機能は無効）
YOUTUBE_API_KEY=
# 発言欄のキーワード検索・候補リスト等（既定オフ）。有効にするときだけ 1
# NEXT_PUBLIC_YOUTUBE_KEYWORD_SEARCH_ENABLED=1
# 旧: 無効を明示（DISABLED=1 は従来どおり最優先でオフ）
# NEXT_PUBLIC_YOUTUBE_KEYWORD_SEARCH_DISABLED=1

# Ably（同期再生・チャット用。未設定でも起動可・同期は無効）
NEXT_PUBLIC_ABLY_API_KEY=

# Socket.io を使う場合（別サーバーで起動）
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Google Analytics 4（G-XXXXXXXXXX 形式）。未設定なら読み込まない
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 詳細フィードバック・サイトご意見のメール通知（Resend）。RESEND_API_KEY 未設定時は DB のみ保存でメールは送らない
# RESEND_API_KEY=
# 送信元アドレス（Resend で検証済みのドメイン推奨）。未設定時は onboarding@resend.dev
# RESEND_FROM=
# 通知メールの宛先（任意）。カンマ区切りで複数可。未設定時は reeshoron@gmail.com と ymap68@yahoo.co.jp
# FEEDBACK_TO_EMAIL=

# トラブルシュート: 詳細フィードバック（モーダル送信）はメール対象。Good/悪いのみではメールしません。
# サイトへのご意見（ヘッダー「ご意見」）送信時も同じ宛先へメールします（RESEND 設定時）。
# 本番（Vercel 等）では RESEND_API_KEY を環境変数に入れ、デプロイ後に再デプロイ。迷惑メールフォルダも確認。

# Music8 静的 JSON（GCS music8-json-prod）。詳細: docs/music8-json-gcs-handoff.md
# Vercel 本番で GCS を SA 取得する場合（非公開バケット）
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CLOUD_PROJECT=music8-a161a
# ローカル: 鍵ファイルパス
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/sa-key.json
# musicaichat v1（省略時は GCS 既定）。無効化: 0 / off / false
# MUSIC8_MUSICAICHAT_BASE_URL=https://storage.googleapis.com/music8-json-prod/data/musicaichat/v1
# MUSIC8_MUSICAICHAT_INDEX_TTL_MS=3600000
# 曲・アーティスト JSON ベース（管理画面・bulk import。省略時 GCS）
# MUSIC8_SONGS_BASE=https://storage.googleapis.com/music8-json-prod/data/songs
# MUSIC8_BULK_SONGS_BASE=
# MUSIC8_ARTIST_SONGS_BASE=https://storage.googleapis.com/music8-json-prod/data/artists
# MUSIC8_ARTISTS_GCS_BASE=https://storage.googleapis.com/music8-json-prod/data/artists
# MUSIC8_ARTIST_INDEX_URL=https://storage.googleapis.com/music8-json-prod/data/musicaichat/v1/index/artist_index.json
# WordPress REST（JSON 生成スクリプト用・変更なし）
# MUSIC8_WP_REST_BASE_URL=https://xs867261.xsrv.jp/md/wp-json
# mc log/scripts から GCS rsync（m8 側生成を推奨。mc 版は .env.local 自動読込なし）
# MUSIC8_GCS_SYNC=1
# MUSIC8_GCS_BUCKET=gs://music8-json-prod/data
# MUSIC8_GCS_SYNC_SOURCE=E:/m8/public/data
# MUSIC8_GCS_DRY_RUN=1

# 開発用: トップの「開催中の部屋」一覧を疑似的に表示（例: 12 件）。UI 確認専用・本番では未設定
# NEXT_PUBLIC_DEV_MOCK_ACTIVE_ROOMS=12

# AI お試し枠の強制適用（1 で ON）。未設定時は preview（枠は消費しない）
# AI_TRIAL_ENFORCEMENT_ENABLED=1
# 開発者向け AI 無制限（Supabase Auth UUID をカンマ区切り）。チャットヘッダー「AI制限なし（開発者）」
# AI_DEVELOPER_UNLIMITED_USER_IDS=
# サポーター向け AI 無制限（開発者と同様の枠免除）。チャットヘッダー「AI制限なし（サポーター）」
# AI_SUPPORTER_UNLIMITED_USER_IDS=1e9c88e3-715a-4485-8b1e-b418e1d61d88
# middleware の Supabase getUser 待ち ms（超過時は cookie 更新をスキップして 504 回避。既定 4000）
# MIDDLEWARE_SUPABASE_AUTH_TIMEOUT_MS=4000

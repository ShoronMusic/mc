{
  "id": "https://musicchat.jp/",
  "name": "Music Chat（β版）",
  "short_name": "Music Chat",
  "description": "邦楽も洋楽も、YouTube同期視聴×チャット。完全無料。みんなで選曲して一緒に聴こう。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#fafafa",
  "lang": "ja",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/logo/Music_Chat_logo_fabicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo/Music_Chat_logo_fabicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
